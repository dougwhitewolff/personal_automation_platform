# PostgreSQL — outbox, tenant_routers, mailbox_watches (see prisma/schema.prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/personal_automation?schema=public"

# Seed creates mailbox_watches row (M365 Graph poll credentials per inbox)
M365_TENANT_ID=""
M365_CLIENT_ID=""
M365_CLIENT_SECRET=""
M365_USER_EMAIL="doug@4trades.ai"

# Only emails from this address are ingested (poll) and published to Kafka
PLAUD_SENDER_EMAIL="no-reply@plaud.ai"

# Kafka — leave KAFKA_BROKERS empty to skip publishing (outbox rows stay PENDING)
# KAFKA_BROKERS=localhost:9092
KAFKA_BROKERS=""
KAFKA_CLIENT_ID="personal-automation-platform"
KAFKA_PLATFORM_EVENTS_TOPIC="automation.platform.events.v1"

# CRM tenants.id UUID — seed writes tenant_routers; relay fallback when outbox.crm_tenant_id is unset
CRM_DEMO_TENANT_ID=""

OUTBOX_RELAY_BATCH_SIZE="20"
OUTBOX_RELAY_MAX_ATTEMPTS="15"
