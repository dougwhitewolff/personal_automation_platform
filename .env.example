# MongoDB — tenant map, integrations, legacy capture/review models (see prisma/schema.prisma)
DATABASE_URL="mongodb://127.0.0.1:27017/personal_automation"

# PostgreSQL — outbox only (see prisma/outbox/schema.prisma)
DATABASE_URL_OUTBOX="postgresql://postgres:postgres@localhost:5432/outbox?schema=public"

SERVICE_API_KEY_SALT="replace-with-long-random-salt"

M365_TENANT_ID=""
M365_CLIENT_ID=""
M365_CLIENT_SECRET=""
M365_USER_EMAIL="doug@4trades.ai"

# Kafka — leave empty locally to skip publishing (outbox rows stay PENDING)
KAFKA_BROKERS=""
KAFKA_CLIENT_ID="personal-automation-platform"
KAFKA_OUTBOX_TOPIC="automation.email.outbox.v1"

OUTBOX_RELAY_BATCH_SIZE="20"
OUTBOX_RELAY_MAX_ATTEMPTS="15"
