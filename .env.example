# PostgreSQL — single database for tenants, captures, outbox, CRM email mappings (see prisma/schema.prisma)
# Use docker-compose.yml (port 5434) or your own Postgres instance.
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/personal_automation?schema=public"

SERVICE_API_KEY_SALT="replace-with-long-random-salt"

M365_TENANT_ID=""
M365_CLIENT_ID=""
M365_CLIENT_SECRET=""
M365_USER_EMAIL="doug@4trades.ai"

# Kafka — leave empty locally to skip publishing (outbox rows stay PENDING)
KAFKA_BROKERS=""
KAFKA_CLIENT_ID="personal-automation-platform"
KAFKA_OUTBOX_TOPIC="automation.email.outbox.v1"
KAFKA_PLATFORM_EVENTS_TOPIC="automation.platform.events.v1"

# CRM Tenant ID for demo publishes (UUID from CRM database). Used by seed script for
# crm_tenant_email_mappings and as relay fallback when mapping + outbox.crm_tenant_id are unset.
CRM_DEMO_TENANT_ID=""

OUTBOX_RELAY_BATCH_SIZE="20"
OUTBOX_RELAY_MAX_ATTEMPTS="15"
