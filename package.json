{
  "name": "personal_automation_platform_v2",
  "version": "1.0.0",
  "description": "A shared automation service for apps that need AI-assisted ingestion, classification, workflow execution, and tool actions.",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "prisma generate && tsup src/main.ts --format cjs --target node20 --out-dir dist --clean --external @prisma/client",
    "start": "node dist/main.js",
    "start:dev": "tsx watch src/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts",
    "plaud:tier1": "tsx scripts/plaud-tier1-test-seed.ts",
    "plaud:tier1:list": "tsx scripts/plaud-tier1-test-seed.ts list",
    "plaud:tier1:happy": "tsx scripts/plaud-tier1-test-seed.ts run --suite=happy-path",
    "plaud:tier1:edge": "tsx scripts/plaud-tier1-test-seed.ts run --suite=edge-cases"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dougwhitewolff/personal_automation_platform_v2.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "bugs": {
    "url": "https://github.com/dougwhitewolff/personal_automation_platform_v2/issues"
  },
  "homepage": "https://github.com/dougwhitewolff/personal_automation_platform_v2#readme",
  "dependencies": {
    "@nestjs/common": "^11.1.19",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.19",
    "@nestjs/platform-express": "^11.1.19",
    "@nestjs/schedule": "^6.1.3",
    "@prisma/client": "^6.19.3",
    "inngest": "^4.3.0",
    "kafkajs": "^2.2.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^4.1.5",
    "prisma": "^6.19.3",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
